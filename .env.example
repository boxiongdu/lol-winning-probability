# Copy to .env locally. Never commit your actual credentials.
RIOT_API_KEY=
RIOT_REGION=americas
RIOT_QUEUE_ID=420
TARGET_MATCH_COUNT=100
# Host-side commands use localhost; the compose services override this with the db service.
DATABASE_URL=postgresql://rift:rift_local@localhost:5432/rift
# A single collector spaces calls conservatively; 429 Retry-After is also honored.
RIOT_REQUEST_INTERVAL=1.3
# Default seed for the game app (each session can change it in the sidebar).
RANDOM_SEED=42
# Linux only: set to the output of `id -u` so Airflow can write to ./models.
# AIRFLOW_UID=1000
